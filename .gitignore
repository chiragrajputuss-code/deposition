__pycache__/
*.py[cod]
.venv/
dist/
build/
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
# local traces produced by examples / manual runs. Anchored with a leading
# slash: a bare `deposition/` would also exclude src/deposition/.
/deposition/
# example 14's output: *.jsonl is already ignored below, but this also
# covers any .sig/.pem sidecar a future run might write beside it.
.deposition-import/
*.jsonl
!tests/**/*.jsonl
# the trace bundled with `deposition demo` - the one .jsonl outside tests/
# that is meant to ship, not a trace produced by running the SDK.
!src/deposition/_demo/run_demo.jsonl
.DS_Store
/_demo_build/
